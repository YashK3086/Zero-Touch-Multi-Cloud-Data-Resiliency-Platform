FROM python:3.11-slim

WORKDIR /app

# Install runtime dependencies and security utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -u 10001 -m -s /bin/bash appuser \
    && mkdir -p /app/keys \
    && chown -R appuser:appuser /app

COPY pyproject.toml .
COPY --chown=appuser:appuser src/ /app/src/
RUN pip install --no-cache-dir .

USER appuser

ENV PYTHONUNBUFFERED=1

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
  CMD python -c "from sf_dr_controller.config import Settings; s = Settings(); assert s.snowflake_account_primary" || exit 1

ENTRYPOINT ["sf-dr-controller"]
CMD ["--plain-logs", "daemon", "--interval", "10", "--strikes", "3"]
