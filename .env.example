# Copy to .env and fill in. NEVER commit .env.
# Load into PowerShell with:  . .\scripts\Load-Env.ps1

# --- Snowflake (ORGNAME-ACCOUNTNAME identifiers) ---
SNOWFLAKE_ACCOUNT_PRIMARY="MYORG-AWS_PRIMARY"
SNOWFLAKE_ACCOUNT_SECONDARY="MYORG-AZURE_SECONDARY"
SNOWFLAKE_USER="DR_CONTROLLER_USER"
SNOWFLAKE_PASSWORD=""
SNOWFLAKE_ROLE="ACCOUNTADMIN"
# Preferred over password (PKCS#8, unencrypted). Leave empty to use password.
SNOWFLAKE_PRIVATE_KEY_PATH=""
# Only if the secondary account's admin login differs from the primary
SNOWFLAKE_SECONDARY_USER=""
SNOWFLAKE_SECONDARY_PASSWORD=""

SNOWFLAKE_FAILOVER_GROUP_NAME="SF_DR_FAILOVER_GROUP"
SNOWFLAKE_REDIRECT_CONNECTION_NAME="SF_DR_GLOBAL_REDIRECT"

# --- DR controller tunables ---
DR_PROBE_INTERVAL_SECONDS="10"
DR_PROBE_TIMEOUT_SECONDS="10"
DR_FAILURE_THRESHOLD="3"
DR_AUTO_FAILOVER="true"
DR_DRY_RUN="false"
DR_WEBHOOK_URL=""
SLACK_WEBHOOK_URL=""

# --- AWS ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

# --- Azure (service principal) ---
AZURE_SUBSCRIPTION_ID=""
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
