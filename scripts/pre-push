#!/bin/sh
echo "----------------------------------------------------------------------"
echo "🚀 Pre-Push Hook: Live Multi-Cloud Telemetry Active!"
echo "🌐 Auto-launching Executive DR Control Plane (http://127.0.0.1:8000/)..."
echo "----------------------------------------------------------------------"

# 1. Fetch remote branches to keep local tracking up to date
git fetch --all --prune --quiet 2>/dev/null || true

# 2. Check if FastAPI Controller is running on port 8000; start if not, then pop browser
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "
    \$conn = Get-NetTCPConnection -LocalPort 8000 -ErrorAction SilentlyContinue
    if (-not \$conn) {
        Write-Host '⚡ Starting FastAPI DR Control Plane on http://127.0.0.1:8000/...' -ForegroundColor Cyan
        Start-Process powershell -ArgumentList '-NoExit', '-Command', 'cd c:\CSPM_PROJECT; .\.venv\Scripts\python.exe -m uvicorn sf_dr_controller.api:app --host 127.0.0.1 --port 8000' -WindowStyle Minimized
        Start-Sleep -Seconds 2
    }
    Start-Process 'http://127.0.0.1:8000/'
" &

exit 0
